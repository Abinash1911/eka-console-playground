diff --git a/med_assist/service/voice/handover.py b/med_assist/service/voice/handover.py
new file mode 100644
index 0000000..9976a07
--- /dev/null
+++ b/med_assist/service/voice/handover.py
@@ -0,0 +1,185 @@
+"""
+Handing a phone call to a person.
+
+How it works on Vobiz (https://www.vobiz.ai/docs/call/transfer-call and
+/docs/xml/dial):
+
+1. The agent calls the ``transfer_to_human`` tool; after it has told the caller
+   it is connecting them (see ``handover_processor``) we POST Vobiz's Transfer
+   API for the live call, pointing the caller's leg at our ``/voice/transfer``
+   URL.
+2. Vobiz interrupts the audio stream and fetches that URL, which returns a
+   ``<Dial>`` to the staff number (``transfer_xml``). The audio WebSocket closes
+   and the call is saved as usual.
+3. When the Dial ends, Vobiz asks ``/voice/transfer-result``; ``completed``
+   hangs up, anything else (busy, no answer) gets a short apology.
+
+Both URLs carry a signed, short-lived token (``telephony_auth``), and the
+feature is off unless ``VOICE_TELEPHONY_SECRET`` is set, because the transfer
+URL returns the staff number.
+
+Config: ``VOBIZ_AUTH_ID`` and ``VOBIZ_AUTH_TOKEN`` (already used by the voice
+pipeline) and optionally ``VOBIZ_API_BASE_URL``.
+"""
+
+import os
+import re
+from dataclasses import dataclass
+from typing import Awaitable, Callable, Optional
+from xml.sax.saxutils import escape, quoteattr
+
+import httpx
+import orjson
+
+from common.config import get_config
+from common.utils import get_logger
+from med_assist.models.session import SessionCache
+from med_assist.service.voice import telephony_auth, telephony_binding
+from med_assist.service.voice.handover_settings import HandoverSettings
+
+logger = get_logger("med_assist.service.voice.handover")
+
+TRANSFER_PURPOSE = "transfer"
+VOBIZ_API_BASE_URL = "https://api.vobiz.ai/api/v1"
+TRANSFER_TIMEOUT_SECS = 8
+
+# Said by Vobiz's own text-to-speech when the Dial fails after the AI has gone.
+# Vobiz's voices are listed in its docs without Hindi, so this is English.
+UNAVAILABLE_MESSAGE = (
+    "Sorry, our team could not take your call right now. Please call again later. Goodbye."
+)
+
+_E164 = re.compile(r"^\+[1-9]\d{7,14}$")
+
+
+@dataclass
+class HandoverOffer:
+    """Handover is available on this call: who to ring, and how to start the transfer."""
+
+    settings: HandoverSettings
+    transfer: Callable[[], Awaitable[bool]]
+
+
+def _http_base() -> str:
+    return (get_config().get("HOST") or "").rstrip("/")
+
+
+def _signed_url(path: str, session_id: str) -> str:
+    token = telephony_auth.sign_ws_token(session_id, purpose=TRANSFER_PURPOSE)
+    return f"{_http_base()}/reloaded/med-assist/voice/{path}/{session_id}?token={token}"
+
+
+def transfer_url(session_id: str) -> str:
+    return _signed_url("transfer", session_id)
+
+
+def result_url(session_id: str) -> str:
+    return _signed_url("transfer-result", session_id)
+
+
+def transfer_xml(settings: HandoverSettings, session_id: str, caller_id: Optional[str]) -> str:
+    """The XML Vobiz runs when the caller's leg lands on the transfer URL: ring the staff phone.
+
+    ``caller_id`` must be a Vobiz number the account owns, so it is the number
+    the patient dialled; omitted (Vobiz then uses the caller's) when unknown.
+    """
+    caller_attr = (
+        f" callerId={quoteattr(caller_id)}" if caller_id and _E164.match(caller_id) else ""
+    )
+    return (
+        '<?xml version="1.0" encoding="UTF-8"?>\n'
+        "<Response>\n"
+        f"    <Dial{caller_attr} timeout={quoteattr(str(settings.ring_seconds))}"
+        f' action={quoteattr(result_url(session_id))} method="POST" redirect="true"'
+        f" sipHeaders={quoteattr('Reference=' + session_id)}>\n"
+        f"        <Number>{escape(settings.number)}</Number>\n"
+        "    </Dial>\n"
+        "</Response>"
+    )
+
+
+def result_xml(dial_status: Optional[str]) -> str:
+    """What to do when the Dial ends: hang up if staff spoke to the caller, else apologise."""
+    if (dial_status or "").lower() == "completed":
+        body = "    <Hangup/>\n"
+    else:
+        body = f"    <Speak>{escape(UNAVAILABLE_MESSAGE)}</Speak>\n    <Hangup/>\n"
+    return f'<?xml version="1.0" encoding="UTF-8"?>\n<Response>\n{body}</Response>'
+
+
+def context_of(session_cache: SessionCache) -> dict:
+    """The session context /voice/answer saved (server-built for phone sessions)."""
+    try:
+        context = orjson.loads(session_cache.initial_context or "{}")
+    except orjson.JSONDecodeError:
+        return {}
+    return context if isinstance(context, dict) else {}
+
+
+async def settings_for_session(session_cache: SessionCache) -> Optional[HandoverSettings]:
+    """The staff number and hours for this call's number, or None."""
+    number_uuid = context_of(session_cache).get("integration_uuid")
+    if not number_uuid:
+        return None
+    return await telephony_binding.handover_for_number(number_uuid)
+
+
+async def request_transfer(call_uuid: str, aleg_url: str) -> bool:
+    """Ask Vobiz to send the caller's leg of a live call to ``aleg_url``. True if Vobiz accepted it."""
+    auth_id = os.environ.get("VOBIZ_AUTH_ID", "")
+    auth_token = os.environ.get("VOBIZ_AUTH_TOKEN", "")
+    base = os.environ.get("VOBIZ_API_BASE_URL", VOBIZ_API_BASE_URL).rstrip("/")
+    url = f"{base}/Account/{auth_id}/Call/{call_uuid}/"
+    try:
+        async with httpx.AsyncClient(timeout=TRANSFER_TIMEOUT_SECS) as client:
+            response = await client.post(
+                url,
+                headers={"X-Auth-ID": auth_id, "X-Auth-Token": auth_token},
+                json={"legs": "aleg", "aleg_url": aleg_url, "aleg_method": "POST"},
+            )
+    except httpx.HTTPError as e:
+        logger.error("Vobiz transfer request failed", fn="request_transfer", error=type(e).__name__)
+        return False
+    if response.status_code // 100 != 2:
+        # Status only: the URL carries a token and the body is Vobiz's.
+        logger.error(
+            "Vobiz refused the transfer",
+            fn="request_transfer",
+            error=f"HTTP {response.status_code}",
+        )
+        return False
+    logger.info(
+        "Vobiz accepted the transfer", fn="request_transfer", resp_code=response.status_code
+    )
+    return True
+
+
+async def offer_for_call(
+    session_cache: SessionCache, call_id: Optional[str]
+) -> Optional[HandoverOffer]:
+    """Handover for this call, or None when any prerequisite is missing (logged)."""
+    session_id = session_cache.session_id
+    if not telephony_auth.is_enforced():
+        return _not_offered(session_id, "VOICE_TELEPHONY_SECRET is not set")
+    if not (os.environ.get("VOBIZ_AUTH_ID") and os.environ.get("VOBIZ_AUTH_TOKEN")):
+        return _not_offered(session_id, "VOBIZ_AUTH_ID / VOBIZ_AUTH_TOKEN are not set")
+    if not _http_base():
+        return _not_offered(session_id, "HOST is not set")
+    call_uuid = call_id or context_of(session_cache).get("call_uuid")
+    if not call_uuid:
+        return _not_offered(session_id, "no call id")
+    settings = await settings_for_session(session_cache)
+    if settings is None:
+        return _not_offered(session_id, "no handover configured for this number")
+
+    async def transfer() -> bool:
+        return await request_transfer(call_uuid, transfer_url(session_id))
+
+    return HandoverOffer(settings=settings, transfer=transfer)
+
+
+def _not_offered(session_id: str, why: str) -> None:
+    logger.info(
+        "Handover not offered on this call", fn="offer_for_call", sid=session_id, reason=why
+    )
+    return None
diff --git a/med_assist/service/voice/handover_processor.py b/med_assist/service/voice/handover_processor.py
new file mode 100644
index 0000000..e219ba4
--- /dev/null
+++ b/med_assist/service/voice/handover_processor.py
@@ -0,0 +1,112 @@
+"""
+Starts the transfer once the agent has finished saying it is connecting the caller.
+
+Placed between the agent and text-to-speech in the phone pipeline. The tool only
+sets ``HandoverState.requested``; this processor waits for the agent's reply to
+end (``LLMFullResponseEndFrame``) and for the caller to have heard it
+(``BotStoppedSpeakingFrame``, confirmed by a short settle so a pause between two
+sentences does not count), then asks Vobiz to move the call. If the agent says
+nothing, a timer starts the transfer anyway. If Vobiz refuses, the caller is told
+and the agent can offer it again.
+"""
+
+import asyncio
+from typing import Awaitable, Callable
+
+from pipecat.frames.frames import (
+    BotStartedSpeakingFrame,
+    BotStoppedSpeakingFrame,
+    Frame,
+    LLMFullResponseEndFrame,
+    TTSSpeakFrame,
+)
+from pipecat.processors.frame_processor import FrameDirection, FrameProcessor
+
+from common.utils import get_logger
+from med_assist.service.voice.handover_tool import HandoverState
+
+logger = get_logger("med_assist.service.voice.handover_processor")
+
+# After the bot stops, wait this long for it to start again (next sentence) before moving the call.
+SETTLE_SECS = 0.5
+# If the reply is never spoken (empty reply, TTS error), move the call after this long.
+SILENT_REPLY_GRACE_SECS = 8
+FAILURE_MESSAGE = "Sorry, I could not connect you right now. How else can I help you?"
+
+
+class HandoverProcessor(FrameProcessor):
+    def __init__(
+        self,
+        state: HandoverState,
+        transfer: Callable[[], Awaitable[bool]],
+        session_id: str,
+        settle_secs: float = SETTLE_SECS,
+        grace_secs: float = SILENT_REPLY_GRACE_SECS,
+        **kwargs,
+    ):
+        super().__init__(**kwargs)
+        self._state = state
+        self._transfer = transfer
+        self._session_id = session_id
+        self._settle_secs = settle_secs
+        self._grace_secs = grace_secs
+        self._reply_ended = False
+        self._bot_restarted = False
+        self._started = False
+        self._tasks: set[asyncio.Task] = set()
+
+    async def process_frame(self, frame: Frame, direction: FrameDirection):
+        await super().process_frame(frame, direction)
+        await self.push_frame(frame, direction)
+
+        if not self._state.requested or self._started:
+            return
+        if isinstance(frame, LLMFullResponseEndFrame):
+            self._reply_ended = True
+            self._spawn(self._after(self._grace_secs))
+        elif isinstance(frame, BotStartedSpeakingFrame):
+            self._bot_restarted = True
+        elif isinstance(frame, BotStoppedSpeakingFrame) and self._reply_ended:
+            self._bot_restarted = False
+            self._spawn(self._after(self._settle_secs, only_if_quiet=True))
+
+    def _spawn(self, coro):
+        task = asyncio.create_task(coro)
+        self._tasks.add(task)
+        task.add_done_callback(self._tasks.discard)
+
+    async def _after(self, delay: float, only_if_quiet: bool = False):
+        await asyncio.sleep(delay)
+        if only_if_quiet and self._bot_restarted:
+            return
+        await self._start_transfer()
+
+    async def _start_transfer(self):
+        if self._started or not self._state.requested:
+            return
+        self._started = True
+        if await self._transfer():
+            logger.info("Handover started", fn="_start_transfer", sid=self._session_id)
+            return
+        logger.error(
+            "Handover failed — caller stays with the agent",
+            fn="_start_transfer",
+            sid=self._session_id,
+            error="transfer request not accepted",
+        )
+        # Let the agent offer it again, and tell the caller now. Timers from this
+        # attempt must not fire for the next one.
+        self._cancel_pending()
+        self._state.requested = False
+        self._started = False
+        self._reply_ended = False
+        await self.push_frame(TTSSpeakFrame(text=FAILURE_MESSAGE))
+
+    def _cancel_pending(self):
+        for task in list(self._tasks):
+            if task is not asyncio.current_task():
+                task.cancel()
+
+    async def cleanup(self):
+        await super().cleanup()
+        self._cancel_pending()
diff --git a/med_assist/service/voice/handover_settings.py b/med_assist/service/voice/handover_settings.py
new file mode 100644
index 0000000..2e79107
--- /dev/null
+++ b/med_assist/service/voice/handover_settings.py
@@ -0,0 +1,111 @@
+"""
+Where a phone call can be handed to a person, and when.
+
+The console stores this as ``handover`` in the agent binding's ``config`` (the
+``product_integrations`` row for the number); ``telephony_binding`` reads it
+here. Shape, as validated by the console:
+
+    {"number": "+919999911111",
+     "hours": {"start": "09:00", "end": "18:00", "timezone": "Asia/Kolkata"},
+     "ring_seconds": 30}
+
+``hours`` is optional (absent = always available); ``start`` after ``end``
+means overnight.
+"""
+
+import re
+from datetime import datetime, time
+from typing import Any, Optional
+from zoneinfo import ZoneInfo, ZoneInfoNotFoundError
+
+import orjson
+from pydantic import BaseModel, Field, ValidationError, field_validator
+
+from common.utils import get_logger
+
+logger = get_logger("med_assist.service.voice.handover_settings")
+
+_E164 = re.compile(r"^\+[1-9]\d{7,14}$")
+
+
+class HandoverHours(BaseModel):
+    start: str
+    end: str
+    timezone: str = "Asia/Kolkata"
+
+    # The console validates these, but they come from a shared database and end
+    # up in a live call, so a bad value must fail here, not mid-call.
+    @field_validator("start", "end")
+    @classmethod
+    def _clock_time(cls, value: str) -> str:
+        time.fromisoformat(value)
+        return value
+
+    @field_validator("timezone")
+    @classmethod
+    def _known_timezone(cls, value: str) -> str:
+        try:
+            ZoneInfo(value)
+        except (ZoneInfoNotFoundError, ValueError):
+            raise ValueError(f"unknown timezone {value!r}") from None
+        return value
+
+
+class HandoverSettings(BaseModel):
+    number: str
+    hours: Optional[HandoverHours] = None
+    ring_seconds: int = Field(default=30, ge=10, le=60)
+
+    @field_validator("number")
+    @classmethod
+    def _phone_number(cls, value: str) -> str:
+        # It is written into call-control XML, so only a plain E.164 number is accepted.
+        if not _E164.match(value):
+            raise ValueError("number must be E.164, like +918000012345")
+        return value
+
+    def is_open(self, now: Optional[datetime] = None) -> bool:
+        """True when staff can take a call at ``now`` (default: the current time)."""
+        if self.hours is None:
+            return True
+        local = (now or datetime.now(ZoneInfo(self.hours.timezone))).astimezone(
+            ZoneInfo(self.hours.timezone)
+        )
+        start, end = time.fromisoformat(self.hours.start), time.fromisoformat(self.hours.end)
+        at = local.time().replace(second=0, microsecond=0)
+        if start < end:
+            return start <= at < end
+        return at >= start or at < end  # overnight
+
+    def hours_text(self) -> str:
+        if self.hours is None:
+            return "any time"
+        return f"{self.hours.start} to {self.hours.end} ({self.hours.timezone})"
+
+
+def from_binding_config(config: Any) -> Optional[HandoverSettings]:
+    """Handover settings from a binding's ``config`` JSON, or None if absent or unusable.
+
+    A bad value must not break the call: the agent just is not offered handover.
+    """
+    if isinstance(config, (str, bytes)):
+        try:
+            config = orjson.loads(config)
+        except orjson.JSONDecodeError:
+            logger.warning(
+                "Binding config is not JSON", fn="from_binding_config", error="invalid json"
+            )
+            return None
+    handover = (config or {}).get("handover") if isinstance(config, dict) else None
+    if not handover:
+        return None
+    try:
+        return HandoverSettings.model_validate(handover)
+    except ValidationError as e:
+        # Fields and reasons only: the input would put a phone number in the logs.
+        logger.warning(
+            "Handover settings unusable — not offering handover",
+            fn="from_binding_config",
+            error=str(e.errors(include_input=False, include_url=False, include_context=False)),
+        )
+        return None
