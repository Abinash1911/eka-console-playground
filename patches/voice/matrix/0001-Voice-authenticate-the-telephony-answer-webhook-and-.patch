diff --git a/med_assist/service/voice/telephony_auth.py b/med_assist/service/voice/telephony_auth.py
new file mode 100644
index 0000000..c4d628f
--- /dev/null
+++ b/med_assist/service/voice/telephony_auth.py
@@ -0,0 +1,103 @@
+"""
+Authentication for the Vobiz telephony entry points.
+
+Two doors, both reachable from the open internet:
+
+- the answer webhook (``POST /voice/answer``), which creates a session, and
+- the audio WebSocket (``/voice/session/{session_id}/``), which runs the call.
+
+Vobiz cannot do an interactive login, so neither can carry a ``sess_token``.
+Instead, one shared secret (``VOICE_TELEPHONY_SECRET`` in the MATRIX config)
+guards both:
+
+- the answer URL configured in Vobiz carries the secret as ``?key=``, and
+- ``/answer`` hands Vobiz a WebSocket URL with a short-lived ``token`` that is
+  an HMAC of the session id, so only a session this server just minted can be
+  attached to.
+
+When the secret is not configured nothing is enforced and behaviour is exactly
+what it was before, so deploying this changes nothing until the secret is set
+and the Vobiz answer URL is updated. A logged warning says so.
+"""
+
+import hashlib
+import hmac
+import time
+from typing import Optional
+
+from common.config import get_config_value
+from common.utils import get_logger
+
+logger = get_logger("med_assist.service.voice.telephony_auth")
+
+# Matches MAX_CALL_DURATION_SECS in pipeline.py: a reconnect inside a maximum
+# length call still works, and the token is useless for a different session.
+WS_TOKEN_TTL_SECS = 600
+
+# What a token opens. "ws" is the audio socket; other doors name themselves.
+WS_PURPOSE = "ws"
+
+
+def _secret() -> Optional[bytes]:
+    secret = get_config_value("VOICE_TELEPHONY_SECRET")
+    return secret.encode() if secret else None
+
+
+def is_enforced() -> bool:
+    return _secret() is not None
+
+
+def warn_if_open() -> None:
+    """Say, once per call, that the telephony entry points are unauthenticated."""
+    if not is_enforced():
+        logger.warning(
+            "VOICE_TELEPHONY_SECRET not set — telephony answer and audio socket are unauthenticated",
+            fn="warn_if_open",
+        )
+
+
+def answer_key_ok(key: Optional[str]) -> bool:
+    """True when the ``key`` on the answer URL is the shared secret (or none is configured)."""
+    secret = _secret()
+    if secret is None:
+        return True
+    return bool(key) and hmac.compare_digest(key.encode(), secret)
+
+
+def _mac(secret: bytes, purpose: str, session_id: str, expires_at: int) -> str:
+    return hmac.new(
+        secret, f"{purpose}.{session_id}.{expires_at}".encode(), hashlib.sha256
+    ).hexdigest()
+
+
+def sign_ws_token(session_id: str, purpose: str = WS_PURPOSE, now: Optional[float] = None) -> str:
+    """``<expiry>.<mac>`` for this session and purpose, or "" when no secret is configured.
+
+    The purpose is part of what is signed, so a token made for one door never opens another.
+    """
+    secret = _secret()
+    if secret is None:
+        return ""
+    expires_at = int((time.time() if now is None else now) + WS_TOKEN_TTL_SECS)
+    return f"{expires_at}.{_mac(secret, purpose, session_id, expires_at)}"
+
+
+def verify_ws_token(
+    session_id: str,
+    token: Optional[str],
+    purpose: str = WS_PURPOSE,
+    now: Optional[float] = None,
+) -> bool:
+    """True for a valid, unexpired token for this session and purpose (or when none is configured)."""
+    secret = _secret()
+    if secret is None:
+        return True
+    try:
+        expiry_part, mac = (token or "").split(".", 1)
+        expires_at = int(expiry_part)
+    except ValueError:
+        return False
+    if expires_at < (time.time() if now is None else now):
+        return False
+    # Bytes, not str: compare_digest raises on non-ASCII text, and the token is attacker-supplied.
+    return hmac.compare_digest(mac.encode(), _mac(secret, purpose, session_id, expires_at).encode())
diff --git a/med_assist/tests/test_voice_telephony_auth.py b/med_assist/tests/test_voice_telephony_auth.py
new file mode 100644
index 0000000..09e3baf
--- /dev/null
+++ b/med_assist/tests/test_voice_telephony_auth.py
@@ -0,0 +1,193 @@
+import base64
+import re
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock, patch
+
+import pytest
+from fastapi import HTTPException
+
+from common.utils.exceptions import SessionNotFound
+from med_assist.service.voice import telephony_auth
+
+SECRET = "s3cret-value"
+AGENT_ID = base64.b64encode(b"agent-uuid#wsp_1").decode()
+
+
+def _configured(secret=SECRET):
+    return patch.object(
+        telephony_auth,
+        "get_config_value",
+        lambda key, default=None: secret if key == "VOICE_TELEPHONY_SECRET" else default,
+    )
+
+
+class TestAnswerKey:
+    def test_open_when_no_secret_is_configured(self):
+        with _configured(None):
+            assert telephony_auth.is_enforced() is False
+            assert telephony_auth.answer_key_ok(None) is True
+            assert telephony_auth.answer_key_ok("anything") is True
+
+    def test_requires_the_exact_key_when_configured(self):
+        with _configured():
+            assert telephony_auth.is_enforced() is True
+            assert telephony_auth.answer_key_ok(SECRET) is True
+            assert telephony_auth.answer_key_ok(None) is False
+            assert telephony_auth.answer_key_ok("") is False
+            assert telephony_auth.answer_key_ok(SECRET + "x") is False
+
+
+class TestWsToken:
+    def test_round_trip(self):
+        with _configured():
+            token = telephony_auth.sign_ws_token("sess-1", now=1000)
+            assert telephony_auth.verify_ws_token("sess-1", token, now=1001) is True
+
+    def test_bound_to_its_session(self):
+        with _configured():
+            token = telephony_auth.sign_ws_token("sess-1", now=1000)
+            assert telephony_auth.verify_ws_token("sess-2", token, now=1001) is False
+
+    def test_a_token_for_one_door_does_not_open_another(self):
+        with _configured():
+            token = telephony_auth.sign_ws_token("sess-1", purpose="transfer", now=1000)
+            assert (
+                telephony_auth.verify_ws_token("sess-1", token, purpose="transfer", now=1001)
+                is True
+            )
+            assert telephony_auth.verify_ws_token("sess-1", token, now=1001) is False
+            ws_token = telephony_auth.sign_ws_token("sess-1", now=1000)
+            assert (
+                telephony_auth.verify_ws_token("sess-1", ws_token, purpose="transfer", now=1001)
+                is False
+            )
+
+    def test_expires(self):
+        with _configured():
+            token = telephony_auth.sign_ws_token("sess-1", now=1000)
+            last_ok = 1000 + telephony_auth.WS_TOKEN_TTL_SECS
+            assert telephony_auth.verify_ws_token("sess-1", token, now=last_ok) is True
+            assert telephony_auth.verify_ws_token("sess-1", token, now=last_ok + 1) is False
+
+    def test_tampered_expiry_or_mac_is_refused(self):
+        with _configured():
+            expires_at, mac = telephony_auth.sign_ws_token("sess-1", now=1000).split(".")
+            later = f"{int(expires_at) + 9999}.{mac}"
+            assert telephony_auth.verify_ws_token("sess-1", later, now=1001) is False
+            assert (
+                telephony_auth.verify_ws_token("sess-1", f"{expires_at}.{'0' * 64}", now=1001)
+                is False
+            )
+
+    @pytest.mark.parametrize("token", [None, "", "no-dot", "abc.def", "123.", "9999999999.é"])
+    def test_malformed_tokens_are_refused(self, token):
+        with _configured():
+            assert telephony_auth.verify_ws_token("sess-1", token, now=1000) is False
+
+    def test_a_token_signed_with_another_secret_is_refused(self):
+        with _configured("other"):
+            token = telephony_auth.sign_ws_token("sess-1", now=1000)
+        with _configured():
+            assert telephony_auth.verify_ws_token("sess-1", token, now=1001) is False
+
+    def test_not_signed_and_not_checked_without_a_secret(self):
+        with _configured(None):
+            assert telephony_auth.sign_ws_token("sess-1") == ""
+            assert telephony_auth.verify_ws_token("sess-1", None) is True
+
+
+async def _answer(key=None):
+    from med_assist.router.voice import vobiz_answer
+
+    create = AsyncMock(return_value=SimpleNamespace(session_id="sess-1"))
+    with (
+        patch("med_assist.router.voice.create_session", create),
+        patch("med_assist.router.voice.get_config", lambda: {"HOST": "https://matrix.eka.care"}),
+    ):
+        try:
+            response = await vobiz_answer(
+                agent_id=AGENT_ID,
+                key=key,
+                From="+919876543210",
+                To="+911234567890",
+                CallUUID="call-1",
+            )
+        except HTTPException as exc:
+            return exc, create
+    return response, create
+
+
+@pytest.mark.asyncio
+class TestAnswerEndpoint:
+    async def test_rejects_a_missing_key_before_creating_a_session(self):
+        with _configured():
+            exc, create = await _answer(key=None)
+        assert exc.status_code == 403
+        create.assert_not_awaited()
+
+    async def test_rejects_a_wrong_key(self):
+        with _configured():
+            exc, create = await _answer(key="wrong")
+        assert exc.status_code == 403
+        create.assert_not_awaited()
+
+    async def test_good_key_returns_a_signed_socket_url(self):
+        with _configured():
+            response, create = await _answer(key=SECRET)
+            create.assert_awaited_once()
+            body = response.body.decode()
+            url = re.search(r"<Stream[^>]*>([^<]+)</Stream>", body).group(1)
+            assert url.startswith(
+                "wss://matrix-ws.eka.care/reloaded/ws/med-assist/voice/session/sess-1/?token="
+            )
+            token = url.split("?token=")[1]
+            assert telephony_auth.verify_ws_token("sess-1", token) is True
+
+    async def test_unchanged_without_a_secret(self):
+        with _configured(None):
+            response, create = await _answer(key=None)
+        create.assert_awaited_once()
+        body = response.body.decode()
+        assert "?token=" not in body
+        assert "/reloaded/ws/med-assist/voice/session/sess-1/<" in body
+
+
+async def _connect(token):
+    from med_assist.router.voice_ws import vobiz_voice_ws
+
+    websocket = MagicMock()
+    websocket.accept = AsyncMock()
+    websocket.close = AsyncMock()
+    lookup = AsyncMock(side_effect=SessionNotFound())
+    with patch("med_assist.router.voice_ws.get_session_from_cache", lookup):
+        await vobiz_voice_ws(websocket, "sess-1", token=token)
+    return websocket, lookup
+
+
+@pytest.mark.asyncio
+class TestAudioSocket:
+    async def test_refuses_a_bad_token_before_looking_up_the_session(self):
+        with _configured():
+            websocket, lookup = await _connect("1.deadbeef")
+        websocket.close.assert_awaited_once()
+        assert websocket.close.await_args.kwargs["code"] == 4001
+        lookup.assert_not_awaited()
+
+    async def test_refuses_a_missing_token(self):
+        with _configured():
+            websocket, lookup = await _connect("")
+        assert websocket.close.await_args.kwargs["code"] == 4001
+        lookup.assert_not_awaited()
+
+    async def test_a_valid_token_passes_the_gate(self):
+        with _configured():
+            token = telephony_auth.sign_ws_token("sess-1")
+            websocket, lookup = await _connect(token)
+        lookup.assert_awaited_once_with("sess-1")
+        # Got as far as the session lookup (which this test makes fail with 4004).
+        assert websocket.close.await_args.kwargs["code"] == 4004
+
+    async def test_unchanged_without_a_secret(self):
+        with _configured(None):
+            _, lookup = await _connect("")
+        lookup.assert_awaited_once_with("sess-1")
