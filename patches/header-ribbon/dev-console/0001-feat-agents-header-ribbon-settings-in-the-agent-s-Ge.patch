+    // Same rule as the widget: black or white, whichever reads better on the background.
+    ribbonReadableOn(hex) {
+        const h = hex.length === 4 ? '#' + hex.slice(1).replace(/./g, (c) => c + c) : hex;
+        const [r, g, b] = [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
+        return (r * 299 + g * 587 + b * 114) / 1000 > 150 ? '#000000' : '#ffffff';
+    },
+    ribbonPreviewStyle() {
+        const bg = this.ribbonBackground || this.accentColor || '#215fff';
+        const fg = this.ribbonTextColor || this.ribbonReadableOn(bg);
+        return 'background-color:' + bg + ';color:' + fg;
+    },
     titleImgPreview: window._agentThemeInit.titleImgPreview,
     backgroundImgPreview: window._agentThemeInit.backgroundImgPreview,
     assistantIconPreview: window._agentThemeInit.assistantIconPreview,
